# Уровни конфига, ближний перекрывает дальний:
#   <папка ролика>/.env  ->  .vidpipe-channel/.env  ->  ~/.vidpipe/.env
# Ключи API держи в глобальном (~/.vidpipe/.env) — по каналам их дублировать
# не нужно. В .env канала — только то, что отличает язык и голос канала:
# DEFAULT_LANG, WORDS_PER_MIN, WHISPER_LANG, FW_MODEL_SIZE, VOICER_VOICE_ID.
# Канал создаётся командой: vidpipe init --channel ИМЯ

# ============ Модель (шаги script / review / shotlist / flow / thumb) ======
# anthropic — Claude по ключу | ollama — локально, без ключей и без интернета
# openai    — любой OpenAI-совместимый сервер: LM Studio, vLLM, OpenRouter
LLM_PROVIDER=anthropic
LLM_TEMPERATURE=0.8

# --- LLM_PROVIDER=ollama: ключи не нужны вообще ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b-instruct
# OLLAMA_CTX=16384               # НЕ уменьшать: по умолчанию Ollama даёт 2048,
#                                # и методика канала обрежется молча
# OLLAMA_KEEP_ALIVE=30s          # сколько модель висит в видеопамяти после ответа;
#                                # короткое значение освобождает её для whisper

# --- LLM_PROVIDER=openai ---
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=local-model
# OPENAI_API_KEY=               # локальному серверу не нужен

# --- LLM_PROVIDER=anthropic ---
# ключ — глобальный уровень
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
SCRIPT_MAX_TOKENS=16000
LLM_RETRIES=3

# Дефолты для prompt.md (создаётся из --topic, дальше правится руками)
DEFAULT_FORMAT=документальная история
DEFAULT_DURATION_MIN=10
DEFAULT_LANG=русский                # уровень канала: Hindi / русский / English
DEFAULT_TONE=сдержанный, аналитический
DEFAULT_AUDIENCE=взрослые, интересуются историей
# темп речи для расчёта объёма сценария — уровень канала:
# 150 русский, 147 хинди, 140 английский
WORDS_PER_MIN=150
# шаг review: сколько раз редактор проверяет и правит сценарий (0 = только отчёт)
REVIEW_PASSES=2
REVIEW_MAX_TOKENS=4000
# память серии: сколько прошлых выпусков учитывать как запрет на повтор
SERIES_DEPTH=5
# SERIES_FILE=                   # по умолчанию series.jsonl рядом с .vidpipe-channel,
                                 # а без канала — на уровень выше папки ролика

# ============ Озвучка (шаг tts) ============
# ключ — глобальный уровень
VOICER_API_KEY=
VOICER_BASE_URL=https://voiceapi.csv666.ru
# запасной домен, если основной заблокирован:
# VOICER_BASE_URL=https://voiceapiru.csv666.ru

# ID голоса ElevenLabs, 20 символов (найти: vidpipe voices) — уровень канала
VOICER_VOICE_ID=
# только для нестандартных голосов, для штатных оставь пустым
VOICER_PUBLIC_OWNER_ID=
VOICER_MODEL_ID=eleven_v3        # eleven_v3 | eleven_multilingual_v2 | eleven_flash_v2_5
                                 #  | eleven_turbo_v2_5 | eleven_turbo_v2 | eleven_flash_v2
VOICER_STABILITY=0.85            # 0.0-1.0; для eleven_v3 округляется к 0 / 0.5 / 1.0
VOICER_SIMILARITY=0.75           # 0.0-1.0
VOICER_STYLE=0.0                 # 0.0-1.0
VOICER_SPEED=1.0                 # 0.7-1.2
# VOICER_ENGINE=alt              # альтернативный движок: только бесплатные голоса, тариф 1.5x
# VOICER_CHUNK_SIZE=2000         # 500-2000, как сервис режет текст внутри задачи
# VOICER_TEMPLATE_UUID=          # шаблон из Telegram-бота ВМЕСТО настроек выше
                                 # (вместе с ними нельзя — сервис вернёт 422)
VOICER_POLL_SEC=10               # как часто спрашивать статус
VOICER_TIMEOUT_MIN=60            # сколько ждать готовности

# ============ Whisper (шаг srt) ============
WHISPER_BACKEND=faster_whisper   # faster_whisper (без компиляции) | whisper_cpp
WHISPER_LANG=ru                  # уровень канала: ru / hi / en
FW_MODEL_SIZE=medium             # tiny/base/small/medium/large-v3
                                 # уровень канала: для хинди нужен large-v3
FW_DEVICE=cpu                    # cuda если есть видеокарта
FW_COMPUTE_TYPE=int8             # float16 для cuda
FW_VAD=0                         # фильтр тишины: на неанглийских языках режет речь
# whisper.cpp — только при WHISPER_BACKEND=whisper_cpp
WHISPER_BIN=C:/whisper.cpp/build/bin/Release/whisper-cli.exe
WHISPER_MODEL=C:/whisper.cpp/models/ggml-medium.bin
SRT_MAX_LEN=42

# ============ Раскадровка и Flow (шаги shotlist / flow) ============
SCENE_SEC=8                      # длина сцены = длина клипа Veo
SHOTLIST_BATCH=15                # сцен в одном запросе к Claude
FLOW_BATCH=15
THUMB_MAX_TOKENS=2000

# ============ Сборка видео (шаг assemble) ============
CLIPS_DIR=clips                  # папка с кадрами внутри проекта
VIDEO_SIZE=1920x1080
VIDEO_FPS=                       # пусто = взять частоту кадров из клипов Flow
KENBURNS_ZOOM=1.15               # наезд на статичные кадры; 1.0 = выключить
KENBURNS_SUPERSAMPLE=2
BURN_SUBS=0                      # 1 = впечатать субтитры в картинку
SUB_STYLE=FontSize=22,Outline=2,MarginV=60
